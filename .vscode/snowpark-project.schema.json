{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["definition_version", "snowpark"],
  "properties": {
    "definition_version": {
      "enum": ["1.1"]
    },
    "snowpark": {
      "type": "object",
      "required": ["project_name", "stage_name", "src"],
      "properties": {
        "project_name": {"type": "string"},
        "stage_name": {"type": "string"},
        "src": {"type": "string"},
        "functions": {
          "type": "array",
          "items": {"$ref": "#/$defs/callable"}
        },
        "procedures": {
          "type": "array",
          "items": {"$ref": "#/$defs/callable"}
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "argument": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"}
      },
      "additionalProperties": false
    },
    "callable": {
      "type": "object",
      "required": ["name", "handler", "signature", "returns"],
      "properties": {
        "name": {"type": "string"},
        "handler": {"type": "string"},
        "signature": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"$ref": "#/$defs/argument"}}
          ]
        },
        "returns": {"type": "string"},
        "runtime": {"type": ["string", "number"]},
        "imports": {"type": "array", "items": {"type": "string"}},
        "execute_as_caller": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}